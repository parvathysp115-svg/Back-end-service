# Application Configuration
PROJECT_NAME="Automated Resume Training and Job Matching Agents"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="resume_matcher_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/resume_matcher_db"
DATABASE_SYNC_URL="postgresql://postgres:postgres@postgres@localhost:5432/resume_matcher_db"

# Redis & Background Tasks
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# AI / LLM Configuration (Google GenAI Gemini)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
EMBEDDING_MODEL="text-embedding-004"
VECTOR_DIMENSION=768

# Hybrid Matching Algorithm Weights (Sum = 1.0)
WEIGHT_VECTOR_SIMILARITY=0.40
WEIGHT_SKILL_COVERAGE=0.35
WEIGHT_EXPERIENCE_ALIGNMENT=0.15
WEIGHT_HARD_CONSTRAINTS=0.10

# Security & CORS
ALLOWED_ORIGINS=["*"]
MAX_UPLOAD_SIZE_MB=15
